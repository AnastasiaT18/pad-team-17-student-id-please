# Copy to .env in this folder and fill in real values. .env is gitignored - the lab penalises
# committing credentials, and so does every code review you will ever sit through.

# Image tags. Bump when a service is republished.
PLAYER_VERSION=0.1.1
SERVER_MODERATION_SESSION_VERSION=0.1.1
APPLICANT_VERSION=0.3.0
CREDENTIAL_VERSION=0.3.0
SERVER_RULES_VERSION=v0.1.1
UNIVERSITY_RECORD_VERSION=v0.1.1
MODERATION_VERSION=0.2.0
DISCORD_DMS_VERSION=0.3.0

# PostgreSQL - one database per service
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change-me

SERVER_MODERATION_SESSION_DB_USER=moderation_session
SERVER_MODERATION_SESSION_DB_PASSWORD=change-me

APPLICANT_DB_USER=applicant
APPLICANT_DB_PASSWORD=change-me

CREDENTIAL_DB_USER=credential
CREDENTIAL_DB_PASSWORD=change-me

SERVER_RULES_DB_USER=rules_user
SERVER_RULES_DB_PASSWORD=change-me

UNIVERSITY_RECORD_DB_USER=record_user
UNIVERSITY_RECORD_DB_PASSWORD=change-me

MODERATION_DB_USER=moderation
MODERATION_DB_PASSWORD=change-me

DISCORD_DMS_DB_USER=discord_dms
DISCORD_DMS_DB_PASSWORD=change-me

# RabbitMQ - the shared applicant propagation exchange
RABBITMQ_USER=pad
RABBITMQ_PASSWORD=change-me

# JWT - used by University Record Service to identify the calling player
JWT_SECRET=change-me