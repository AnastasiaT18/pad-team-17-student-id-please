# Copy to .env in this folder and fill in real values. .env is gitignored - the lab penalises
# committing credentials, and so does every code review you will ever sit through.

# Image tags. Bump when a service is republished.
GATEWAY_VERSION=0.5.0
BROKER_VERSION=0.1.0

# Lab 5 application cache (separate from Discord's Redis).
# These TTLs take effect once cache-enabled Gateway and Rules images are released.
# Grade 7 cache sharding. Enable the cache-sharding profile before configuring two shards.
# CACHE_REDIS_SHARDS=cache-1=redis://application-cache:6379/0,cache-2=redis://application-cache-2:6379/0
CACHE_MAXMEMORY=128mb
RULES_CACHE_TTL_SECONDS=60
AUTH_CACHE_TTL_SECONDS=60

PLAYER_VERSION=0.5.0
SERVER_MODERATION_SESSION_VERSION=0.5.0
APPLICANT_VERSION=4.1.0
CREDENTIAL_VERSION=4.1.0
SERVER_RULES_VERSION=v0.5.0
UNIVERSITY_RECORD_VERSION=v0.4.0
MODERATION_VERSION=v0.5.0
DISCORD_DMS_VERSION=v0.5.0

# Lab 5 Grade 8 end-shift 2PC. Enable after updating all four service image tags.
# The README lists the internal addresses. Generate three distinct tokens in .env.
END_SHIFT_2PC_ENABLED=false
BROKER_TRANSACTION_ADDRESSES={}
BROKER_GATEWAY_TOKEN=
PLAYER_SERVICE_TRANSACTION_TOKEN=
SERVER_MODERATION_SESSION_SERVICE_TRANSACTION_TOKEN=

# PostgreSQL - one database per service
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change-me

SERVER_MODERATION_SESSION_DB_USER=moderation_session
SERVER_MODERATION_SESSION_DB_PASSWORD=change-me

APPLICANT_DB_USER=applicant
APPLICANT_DB_PASSWORD=change-me
APPLICANT_REPLICATION_PASSWORD=change-me-applicant-replication

CREDENTIAL_DB_USER=credential
CREDENTIAL_DB_PASSWORD=change-me
CREDENTIAL_REPLICATION_PASSWORD=change-me-credential-replication

SERVER_RULES_DB_USER=rules_user
SERVER_RULES_DB_PASSWORD=change-me
SERVER_RULES_REPLICATION_PASSWORD=change-me-rules-replication

UNIVERSITY_RECORD_DB_USER=record_user
UNIVERSITY_RECORD_DB_PASSWORD=change-me
UNIVERSITY_RECORD_REPLICATION_PASSWORD=change-me-record-replication

# After preparing this deployment for replication, persist both files for ALL future commands.
# COMPOSE_FILE=docker-compose.yml:docker-compose.replication.yml

MODERATION_DB_USER=moderation
MODERATION_DB_PASSWORD=change-me

DISCORD_DMS_DB_USER=discord_dms
DISCORD_DMS_DB_PASSWORD=change-me

# JWT - Player signs login tokens; Gateway and Discord Socket.IO verify with the same secret
JWT_SECRET=change-me

# Grafana - the admin login (the dashboard itself opens without one, read-only)
GRAFANA_ADMIN_PASSWORD=change-me

# Service Discovery - its image, and the Telegram bot and group its health alerts go to. The bot's
# token is a secret - whoever has it controls the bot - so the real one goes in .env only.
DISCOVERY_IMAGE=dannacojocari/pad-team-17-discovery-service:0.2.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRITICAL_LOAD_THRESHOLD=0.8

# Discord DMs - internal log download authentication
DISCORD_DMS_LOG_DOWNLOAD_TOKEN=change-me
# Moderation Service - internal log download authentication
MODERATION_LOG_DOWNLOAD_TOKEN=change-me

# Lab 5 analytics. Publish v0.1.0 before pulling; a verified image digest may be used instead.
ANALYTICS_IMAGE=dannacojocari/pad-team-17-analytics:v0.1.0
ANALYTICS_WAREHOUSE_PASSWORD=change-me
ANALYTICS_WAREHOUSE_DSN=postgresql://analytics:change-me@analytics-warehouse:5432/analytics
# Dedicated reader passwords, not the source database-owner passwords above.
# Percent-encode special characters in DSN credentials.
ANALYTICS_MODERATION_DSN=postgresql://analytics_reader:change-me@moderation-db:5432/moderation
ANALYTICS_DISCORD_DSN=postgresql://analytics_reader:change-me@discord-dms-db:5432/discord_dms
ANALYTICS_PLAYER_DSN=postgresql://analytics_reader:change-me@player-db:5432/player
ANALYTICS_SESSION_DSN=postgresql://analytics_reader:change-me@server-moderation-session-db:5432/server_moderation_session
ANALYTICS_APPLICANT_DSN=postgresql://analytics_reader:change-me@applicant-db:5432/applicant
ANALYTICS_CREDENTIAL_DSN=postgresql://analytics_reader:change-me@credential-db:5432/credential
ANALYTICS_RULES_DSN=postgresql://analytics_reader:change-me@server-rules-db:5432/rules_db
ANALYTICS_RECORD_DSN=postgresql://analytics_reader:change-me@university-record-db:5432/record_db
# Used only by the replication overlay: libpq-compatible primary-only multi-host DSNs.
# Keep the same dedicated reader credentials; validate them against the deployed ETL image.
ANALYTICS_APPLICANT_HA_DSN=postgresql://analytics_reader:change-me@applicant-db:5432,applicant-db-standby-1:5432,applicant-db-standby-2:5432/applicant?target_session_attrs=primary&connect_timeout=2
ANALYTICS_CREDENTIAL_HA_DSN=postgresql://analytics_reader:change-me@credential-db:5432,credential-db-standby-1:5432,credential-db-standby-2:5432/credential?target_session_attrs=primary&connect_timeout=2
ANALYTICS_RULES_HA_DSN=postgresql://analytics_reader:change-me@server-rules-db:5432,server-rules-db-standby-1:5432,server-rules-db-standby-2:5432/rules_db?target_session_attrs=read-write&connect_timeout=2
ANALYTICS_RECORD_HA_DSN=postgresql://analytics_reader:change-me@university-record-db:5432,university-record-db-standby-1:5432,university-record-db-standby-2:5432/record_db?target_session_attrs=read-write&connect_timeout=2
ANALYTICS_MODERATION_TIMEZONE=UTC
ANALYTICS_DISCORD_TIMEZONE=UTC
ETL_INTERVAL_SECONDS=300
ETL_RECONCILE_SECONDS=86400
ETL_OVERLAP_SECONDS=600

# Opt-in replication overlay. Fill released tag/digest references before cutover.
# The two database images are published by the corresponding private service repos.
MODERATION_REPLICATION_APP_IMAGE=
MODERATION_DATABASE_IMAGE=
DISCORD_DMS_REPLICATION_APP_IMAGE=
DISCORD_DMS_DATABASE_IMAGE=
MODERATION_REPLICATION_PASSWORD=change-me
DISCORD_DMS_REPLICATION_PASSWORD=change-me
# Keep the SAME existing analytics reader credentials, changing only the host.
ANALYTICS_MODERATION_REPLICATION_DSN=postgresql://analytics_reader:change-me@moderation-db-router:5432/moderation
ANALYTICS_DISCORD_REPLICATION_DSN=postgresql://analytics_reader:change-me@discord-dms-db-router:5432/discord_dms

# Player and Session replication overlay. Use the existing dedicated analytics
# reader credentials in the multi-host DSNs. The primary setting selects the node role.
PLAYER_REPLICATION_PASSWORD=change-me-player-replication
SESSION_REPLICATION_PASSWORD=change-me-session-replication
ANALYTICS_PLAYER_HA_DSN=postgresql://analytics_reader:change-me@player-db-1:5432,player-db-2:5432,player-db-3:5432/player?target_session_attrs=primary&connect_timeout=2
ANALYTICS_SESSION_HA_DSN=postgresql://analytics_reader:change-me@session-db-1:5432,session-db-2:5432,session-db-3:5432/server_moderation_session?target_session_attrs=primary&connect_timeout=2
