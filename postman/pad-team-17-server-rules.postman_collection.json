            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('repeated read preserves rule data and IDs', () => pm.expect(pm.response.json().rules).to.deep.eql(JSON.parse(pm.collectionVariables.get('lab5_cache_original'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rules"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cache - replace with a unique rule",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('lab5_cache_original')) throw new Error('Run Cache - capture current rules first');",
                  "const description = 'Lab 5 cache check ' + pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('lab5_cache_write_payload', JSON.stringify({rules:[{description,condition:'year <= 1'}]}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('lab5_cache_written', JSON.stringify(pm.response.json().rules));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{lab5_cache_write_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rules"
              ]
            }
          },
          "response": []
