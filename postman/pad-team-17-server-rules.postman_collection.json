  "item": [
    {
      "name": "Get Rules",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('response has a rules array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('rules');",
              "  pm.expect(body.rules).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{server_rules_url}}/rules",
          "host": [
            "{{server_rules_url}}"
          ],
          "path": [
            "rules"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Replace Rules",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returned rules have generated rule_id and match input', () => {",
              "  pm.expect(body.rules).to.have.lengthOf(1);",
              "  pm.expect(body.rules[0]).to.have.property('rule_id');",
              "  pm.expect(body.rules[0].description).to.eql('Only FAF students');",
              "  pm.expect(body.rules[0].condition).to.eql('university_status != faf_student');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rules\": [\n    { \"description\": \"Only FAF students\", \"condition\": \"university_status != faf_student\" }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{server_rules_url}}/rules",
          "host": [
            "{{server_rules_url}}"
          ],
          "path": [
            "rules"
          ]
        },
        "description": "Replaces the entire active rule set. Note: this wipes the previous rules, so run 'Get Rules' before this if you want to see the prior state."
      },
      "response": []
    },
