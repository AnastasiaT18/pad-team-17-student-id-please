            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"srtest{{run_id}}\",\n  \"email\": \"srtest{{run_id}}@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "players"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login tester",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function decode(t){ try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); } catch(e){ return null; } }",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test('a JWT came back', () => pm.expect(token).to.be.a('string').and.not.be.empty);",
                  "pm.collectionVariables.set('token', token);",
                  "const claims = decode(token);",
                  "if (claims) pm.collectionVariables.set('player_id', claims.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"srtest{{run_id}}@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/players/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "players",
                "login"
              ]
            }
          },
          "response": []
        }
