    {
      "name": "3. Lab 3 - two replicas behind the Gateway",
      "description": "Run these requests back to back and alone (no other traffic in between), so the Gateway's round-robin order is predictable.",
      "item": [
        {
          "name": "Round-robin - first request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('names the replica that answered (X-Instance-Id)', () => {",
                  "  const i = pm.response.headers.get('X-Instance-Id');",
                  "  pm.expect(i, 'X-Instance-Id missing: the service must send it, see the README of this collection').to.be.a('string').and.not.be.empty;",
                  "  pm.collectionVariables.set('first_instance', i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rules"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Round-robin - next request goes to the other replica",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by the OTHER replica', () => {",
                  "  const i = pm.response.headers.get('X-Instance-Id');",
                  "  pm.expect(i).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(i).to.not.eql(pm.collectionVariables.get('first_instance'));",
                  "  pm.collectionVariables.set('second_instance', i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rules"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Round-robin - third request wraps back to the first replica",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('back to the first replica (round-robin wraps around)', () => {",
                  "  pm.expect(pm.response.headers.get('X-Instance-Id')).to.eql(pm.collectionVariables.get('first_instance'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rules"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Instance-agnostic - write through one replica",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const i = pm.response.headers.get('X-Instance-Id');",
                  "pm.test('names the replica', () => pm.expect(i).to.be.a('string').and.not.be.empty);",
                  "pm.collectionVariables.set('first_instance', i);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rules\": [\n    {\n      \"description\": \"Only FAF students\",\n      \"condition\": \"university_status != faf_student\"\n    },\n    {\n      \"description\": \"Student id must be set\",\n      \"condition\": \"student_id == null\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rules"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Instance-agnostic - read it through the other replica",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by a different replica', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.not.eql(pm.collectionVariables.get('first_instance')));",
                  "pm.test('the other replica returns the rules just written', () => pm.expect(pm.response.json().rules).to.have.lengthOf(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rules"
              ]
            }
          },
          "response": []
        },
