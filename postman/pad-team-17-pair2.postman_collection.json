{
  "info": {
    "name": "PAD Team 17 - Pair 2 (Applicant + Credential)",
    "description": "Applicant Service and Credential Service, Team 17 \"Student ID, please\".\n\nRun the two services first - see deploy/docker-compose.yml in this repository.\nEvery request asserts that `deception` never appears in a player-facing response: it is the ground-truth answer to the puzzle and leaking it would end the game.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Applicant Service",
      "item": [
        {
          "name": "Create applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{applicant_url}}/applicants",
              "host": [
                "{{applicant_url}}"
              ],
              "path": [
                "applicants"
              ]
            },
            "description": "Generates a new applicant for a shift. This service is contacted first, so it mints the applicant_id and the deception, then publishes applicant_initialized.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('applicant_id', body.applicant_id);",
                  "pm.test('claim is complete', () => {",
                  "  pm.expect(body).to.have.property('name');",
                  "  pm.expect(body).to.have.property('student_id');",
                  "  pm.expect(body).to.have.property('university_status');",
                  "});",
                  "pm.test('deception is never exposed to players', () => {",
                  "  pm.expect(body).to.not.have.property('deception');",
                  "  pm.expect(body).to.not.have.property('is_deceptive');",
                  "});"
                ]
              }
            }
          ]
        },
        {
