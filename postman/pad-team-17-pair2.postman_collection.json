              "raw": "{{credential_url}}/credentials",
              "host": [
                "{{credential_url}}"
              ],
              "path": [
                "credentials"
              ]
            },
            "description": "Generates documents for a new applicant when Credential Service is contacted first. It mints the applicant_id and the deception, then publishes credential_initialized.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('credential_applicant_id', body.applicant_id);",
                  "pm.test('both documents carry a verdict', () => {",
                  "  pm.expect(body.student_id_doc).to.have.property('valid');",
                  "  pm.expect(body.student_id_doc).to.have.property('issue');",
                  "  pm.expect(body.enrollment_confirmation).to.have.property('valid');",
                  "});",
                  "pm.test('an invalid document always has a reason', () => {",
                  "  for (const doc of [body.student_id_doc, body.enrollment_confirmation]) {",
                  "    if (!doc.valid) { pm.expect(doc.issue).to.not.eql('none'); }",
                  "  }",
                  "});",
                  "pm.test('deception is never exposed to players', () =>",
                  "  pm.expect(body).to.not.have.property('deception'));"
                ]
              }
            }
          ]
        },
