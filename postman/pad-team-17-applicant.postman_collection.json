    {
      "name": "Lab 5 Grade 9 - create-applicant saga",
      "description": "Run the shift requests at the top of this collection first. With CREATE_APPLICANT_SAGA_ENABLED=true (see \"Long-running saga\" in the README) the Broker runs POST /applicants as a saga and its 201 carries X-Saga-Id; the saga checks run only then. Without the flag they are skipped and the plain Applicant answers. The last request reads the saga straight from the Broker at {{broker_url}}.",
      "item": [
        {
          "name": "Saga - create an applicant with an Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{saga_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applicants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applicants"
              ]
            },
            "description": "With the saga on, the Broker runs this request as the create-applicant saga (Applicant, Credential, University Record) and the 201 carries X-Saga-Id. A 503 CREATE_APPLICANT_PENDING means the saga goes on in the Broker: the request is sent again with the same key, at most 3 times, and resumes the same saga.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new key starts a new saga; a retry after a 503 keeps the key.",
                  "if (!Number(pm.collectionVariables.get('saga_attempts') || 0)) {",
                  "  pm.collectionVariables.set('saga_key', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.collectionVariables.get('saga_attempts') || 0);",
                  "if (pm.response.code === 503 && attempts < 3) {",
                  "  // CREATE_APPLICANT_PENDING: the same key picks up the same saga.",
                  "  pm.collectionVariables.set('saga_attempts', String(attempts + 1));",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('saga_attempts', '0');",
                  "  const sagaId = pm.response.headers.get('X-Saga-Id') || '';",
                  "  pm.collectionVariables.set('saga_enabled', sagaId ? 'true' : 'false');",
                  "  pm.collectionVariables.set('saga_id', sagaId);",
                  "  pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('saga_applicant_id', body.applicant_id);",
                  "  pm.test('deception is never exposed to players', () => pm.expect(body).to.not.have.property('deception'));",
                  "  // Without CREATE_APPLICANT_SAGA_ENABLED the plain Applicant answered: the saga checks are skipped.",
                  "  (sagaId ? pm.test : pm.test.skip)('it ran as a saga: X-Saga-Id is a UUID', () =>",
                  "    pm.expect(sagaId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/));",
                  "}"
                ]
              }
            }
          ]
