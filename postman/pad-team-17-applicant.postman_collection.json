    {
      "name": "Round-robin - first request",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/applicants?session_id={{session_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "applicants?session_id={{session_id}}"
          ]
        },
        "description": "Lab 3, Lab 4. The team's Compose file runs two Applicant Service replicas. The Message Broker sends each request to the least loaded one (its open requests, then the utilization Service Discovery measured, every 5 s), and equally loaded replicas take turns. Every response names the replica that answered in the X-Instance-Id header; this request remembers it."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('names the replica that answered', () => {",
              "  const instance = pm.response.headers.get('X-Instance-Id');",
              "  pm.expect(instance).to.be.a('string').and.not.be.empty;",
              "  pm.collectionVariables.set('first_instance', instance);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Round-robin - the other replica answers too",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/applicants?session_id={{session_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "applicants?session_id={{session_id}}"
          ]
        },
        "description": "A replica that was busy at the last Discovery check is passed over until the next one, so the same replica can answer a few requests in a row. This request is sent again, 1 s apart, until the other replica answers: at most 10 times, longer than one 5 s Discovery check plus the Broker's 2 s cache of the replica list. Needs both replicas registered and healthy in Service Discovery."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A repeated try waits 1 s, so Service Discovery can measure the replicas again.",
              "if (Number(pm.collectionVariables.get('round_robin_tries') || 0) > 0) {",
              "  setTimeout(() => {}, 1000);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const instance = pm.response.headers.get('X-Instance-Id');",
              "const tries = Number(pm.collectionVariables.get('round_robin_tries') || 0) + 1;",
              "const sameReplica = pm.response.code === 200 && instance === pm.collectionVariables.get('first_instance');",
              "if (sameReplica && tries < 10) {",
              "  pm.collectionVariables.set('round_robin_tries', String(tries));",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.set('round_robin_tries', '0');",
              "  pm.test('200 OK', () => pm.response.to.have.status(200));",
              "  pm.test(`answered by the other replica (try ${tries} of 10)`, () => {",
              "    pm.expect(instance).to.be.a('string').and.not.be.empty;",
              "    pm.expect(instance).to.not.eql(pm.collectionVariables.get('first_instance'));",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
