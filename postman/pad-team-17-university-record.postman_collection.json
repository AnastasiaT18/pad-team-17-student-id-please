  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Self-login: registers (or re-uses) test players through the Gateway and stores fresh JWTs.",
          "// Nothing needs to be copied from the Player collection. Re-runs are safe: 409 = already registered.",
          "const base = pm.collectionVariables.get('university_record_url');",
          "const PASSWORD = 'secret123';",
          "const USERS = [{\"tokenVar\": \"token_player1\", \"idVar\": \"player1_id\", \"email\": \"uni-record-player1@example.com\", \"username\": \"unirecordplayer1\"}, {\"tokenVar\": \"token_stranger\", \"idVar\": \"stranger_id\", \"email\": \"uni-record-stranger@example.com\", \"username\": \"unirecordstranger\"}];",
          "",
          "function decode(token) {",
          "  try {",
          "    return JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
          "  } catch (e) { return null; }",
          "}",
          "function stillValid(token) {",
          "  const c = token && decode(token);",
          "  return !!(c && c.exp * 1000 > Date.now() + 60000);",
          "}",
          "function post(path, body, cb) {",
          "  pm.sendRequest({",
          "    url: base + path, method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify(body) }",
          "  }, cb);",
          "}",
          "USERS.forEach(u => {",
          "  if (stillValid(pm.collectionVariables.get(u.tokenVar))) return;",
          "  post('/players', { username: u.username, email: u.email, password: PASSWORD }, () => {",
          "    post('/players/login', { email: u.email, password: PASSWORD }, (err, res) => {",
          "      if (err || res.code !== 200) {",
          "        console.error('Login failed for ' + u.email + ' - is the stack up and Player Service healthy?', err || res.code);",
          "        return;",
          "      }",
          "      const token = res.json().token;",
          "      pm.collectionVariables.set(u.tokenVar, token);",
          "      pm.collectionVariables.set(u.idVar, decode(token).sub);",
          "      console.log(u.tokenVar + ' ready, player id = ' + decode(token).sub);",
          "      if (u.tokenVar === 'token_player1') {",
          "        console.log('ONE-TIME: give this player a scope assignment (needs the DB volume to persist):\\n' +",
          "          \"grpcurl -plaintext -proto services/university-record-service/src/main/proto/university_record.proto \" +",
          "          \"-d '{\\\"session_id\\\":\\\"test-session\\\",\\\"assignments\\\":[{\\\"player_id\\\":\\\"\" + decode(token).sub +",
          "          \"\\\",\\\"scopes\\\":[\\\"enrollment\\\",\\\"courses\\\"]}]}' localhost:9092 UniversityRecordService/AssignScopes\");",
          "      }",
          "    });",
          "  });",
          "});"
        ]
      }
    }
