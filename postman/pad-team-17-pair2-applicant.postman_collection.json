{
  "info": {
    "name": "Applicant Service",
    "description": "Applicant Service - Team 17 \"Student ID, please\".\n\nOwns an applicant's claimed identity. Covers the full CRUD, every error path, and the mocked Session Service lookup (two fixed session ids return 404 and 409).\n\nEvery response is checked for the absence of `deception`: it is the answer to the puzzle the players solve, so leaking it would end the game.\n\nRun the service first - see deploy/docker-compose.yml. Requests are ordered to run start to finish: creating an applicant stores its id for the requests that follow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create applicant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/applicants",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "applicants"
          ]
        },
        "description": "Generates a new applicant for a shift. This service is contacted first, so it mints the applicant_id and the deception, then publishes applicant_initialized.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('applicant_id', body.applicant_id);",
              "pm.test('claim is complete', () => {",
              "  pm.expect(body).to.have.property('name');",
              "  pm.expect(body).to.have.property('student_id');",
              "  pm.expect(body).to.have.property('university_status');",
              "});",
              "pm.test('deception is never exposed to players', () => {",
              "  pm.expect(body).to.not.have.property('deception');",
              "  pm.expect(body).to.not.have.property('is_deceptive');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get applicant",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/applicants/{{applicant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "applicants",
            "{{applicant_id}}"
          ]
        },
        "description": "The claimed profile - what the Moderator is shown."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('deception is never exposed to players', () =>",
              "  pm.expect(pm.response.json()).to.not.have.property('deception'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List applicants of a session",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/applicants?session_id={{session_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "applicants?session_id={{session_id}}"
          ]
        },
        "description": "Every applicant processed in one shift, oldest first."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Amend applicant claim",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/applicants/{{applicant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "applicants",
            "{{applicant_id}}"
          ]
        },
        "description": "The applicant changes their story. Any subset of the claim; the rest stays as it was.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"year\": 3,\n  \"courses\": [\"PAD\", \"SO\"]\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('the amended fields changed', () => {",
              "  pm.expect(body.year).to.eql(3);",
              "  pm.expect(body.courses).to.eql(['PAD', 'SO']);",
              "});",
              "pm.test('deception is never exposed to players', () => pm.expect(body).to.not.have.property('deception'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Amend applicant - student_id is immutable",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/applicants/{{applicant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "applicants",
            "{{applicant_id}}"
          ]
        },
        "description": "The student ID is the card the applicant is holding; the documents and records were built from it.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"FAF-24-9999\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('uses the shared error envelope', () =>",
              "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'));",
              "pm.test('names the field the way it was sent', () =>",
              "  pm.expect(pm.response.json().error.message).to.match(/^student_id cannot be changed/));"
            ]
          }
        }
      ]
    },
