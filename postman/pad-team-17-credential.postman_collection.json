{
  "info": {
    "name": "Credential Service",
    "description": "Credential Service - Team 17 \"Student ID, please\".\n\nOwns the documents an applicant presents and the verdict on each. Covers the full CRUD, every error path, the mocked Session Service lookup, and that a client can never set a verdict itself.\n\nEvery response is checked for the absence of `deception`.\n\nRun the service first - see deploy/docker-compose.yml. Requests are ordered to run start to finish: creating credentials stores the applicant id for the requests that follow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/credentials",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "credentials"
          ]
        },
        "description": "Generates documents for a new applicant when Credential Service is contacted first. It mints the applicant_id and the deception, then publishes credential_initialized.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('applicant_id', body.applicant_id);",
              "pm.test('both documents carry a verdict', () => {",
              "  pm.expect(body.student_id_doc).to.have.property('valid');",
              "  pm.expect(body.student_id_doc).to.have.property('issue');",
              "  pm.expect(body.enrollment_confirmation).to.have.property('valid');",
              "});",
              "pm.test('an invalid document always has a reason', () => {",
              "  for (const doc of [body.student_id_doc, body.enrollment_confirmation]) {",
              "    if (!doc.valid) { pm.expect(doc.issue).to.not.eql('none'); }",
              "  }",
              "});",
              "pm.test('deception is never exposed to players', () =>",
              "  pm.expect(body).to.not.have.property('deception'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get credentials",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/credentials/{{applicant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "credentials",
            "{{applicant_id}}"
          ]
        },
        "description": "An applicant's documents and their validity."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('deception is never exposed to players', () =>",
              "  pm.expect(pm.response.json()).to.not.have.property('deception'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List credentials",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/credentials",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "credentials"
          ]
        },
        "description": "Every document set this service holds."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Resubmit documents",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/credentials/{{applicant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "credentials",
            "{{applicant_id}}"
          ]
        },
        "description": "The applicant hands in a corrected email. The verdicts on the card and the confirmation do not move.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"university_email\": \"corrected@isa.utm.md\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('the email was replaced', () => pm.expect(pm.response.json().university_email).to.eql('corrected@isa.utm.md'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Resubmit documents - verdicts cannot be set",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/credentials/{{applicant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "credentials",
            "{{applicant_id}}"
          ]
        },
        "description": "A verdict is this service's finding, never client input - otherwise a forged card could be marked valid by its owner.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id_doc\": { \"valid\": true, \"issue\": \"none\" }\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('uses the shared error envelope', () =>",
              "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'));",
              "pm.test('names the field the way it was sent', () =>",
              "  pm.expect(pm.response.json().error.message).to.match(/^student_id_doc is decided by this service/));"
            ]
          }
        }
      ]
    },
