  "item": [
    {
      "name": "Channels",
      "item": [
        {
          "name": "Create Channel",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('channel_id', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"name\": \"general-mod-chat\",\n  \"player_ids\": [\n    \"{{player_id}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/channels",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "channels"
              ]
            }
          }
        },
        {
          "name": "Get All Channels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/channels",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "channels"
              ]
            }
          }
        },
        {
          "name": "Get Channel",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/channels/{{channel_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "channels",
                "{{channel_id}}"
              ]
            }
          }
        },
        {
          "name": "Get Session Channels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}/channels",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "{{session_id}}",
                "channels"
              ]
            }
          }
        },
        {
          "name": "Provision Session Channels",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Four channels are provisioned', function () {",
                  "    const channels = pm.response.json();",
                  "",
                  "    pm.expect(channels).to.be.an('array');",
                  "    pm.expect(channels).to.have.length(4);",
                  "});",
                  "",
                  "pm.test('Expected channels are present', function () {",
                  "    const channels = pm.response.json();",
                  "    const names = channels.map((channel) => channel.name);",
                  "",
                  "    pm.expect(names).to.include.members([",
                  "        'enrollment-check',",
                  "        'course-registration',",
                  "        'schedule-check',",
                  "        'general-mod-chat'",
                  "    ]);",
                  "});",
                  "",
                  "pm.test('All provisioned channels belong to the session', function () {",
                  "    const channels = pm.response.json();",
                  "    const sessionId = pm.collectionVariables.get('session_id');",
                  "",
                  "    channels.forEach((channel) => {",
                  "        pm.expect(channel.session_id).to.eql(sessionId);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}/channels/provision",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "{{session_id}}",
                "channels",
                "provision"
              ]
            },
            "description": "Provisions Discord channels and memberships for a session using the Lab 1 mocked Session Service client. The operation is idempotent."
          }
        },
