                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const text = pm.response.text();",
                  "pm.test('Prometheus text format', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));",
                  "pm.test('the broker\\'s own load', () => pm.expect(text).to.include('service_utilization{'));",
                  "pm.test('requests routed to Applicant instances', () => pm.expect(text).to.match(/broker_routed_total\\{[^}]*backend=\"applicant-service\"/));",
                  "pm.test('the load of every instance', () => pm.expect(text).to.include('broker_backend_utilization{'));",
                  "pm.test('events published', () => pm.expect(text).to.include('broker_events_published_total'));",
                  "pm.test('the dead letter counted', () => pm.expect(text).to.match(/broker_event_deliveries_total\\{[^}]*result=\"dead\"\\} [1-9]/));",
                  "pm.test('the queue of Applicant Service', () => pm.expect(text).to.match(/broker_queue_depth\\{[^}]*queue=\"applicant-service\"/));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
