            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 from the service itself', () => pm.response.to.have.status(404));",
                  "pm.test('the service\\'s error code comes back unchanged', () => pm.expect(pm.response.json().error.code).to.eql('APPLICANT_NOT_FOUND'));",
                  "const instance = pm.response.headers.get('X-Instance-Id');",
                  "pm.test('the answering replica is named', () => pm.expect(instance).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('first_instance', instance);"
                ]
              }
            }
          ]
        },
