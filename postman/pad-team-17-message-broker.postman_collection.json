          "name": "Forward again - the other replica answers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/forward/applicant-service/applicants/11111111-1111-4111-8111-111111111111",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "forward",
                "applicant-service",
                "applicants",
                "11111111-1111-4111-8111-111111111111"
              ]
            },
            "description": "Both replicas are idle, so they are equally loaded and take turns: this request goes to the other one."
          },
          "response": [],
          "event": [
