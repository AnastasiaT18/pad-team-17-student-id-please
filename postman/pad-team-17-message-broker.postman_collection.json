            },
            "description": "No service registered this topic with Service Discovery, so the broker does not store the event and the publisher keeps it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"nobody_listens\",\n  \"message_id\": \"{{$guid}}\",\n  \"payload\": {\n    \"applicant_id\": \"{{applicant_id}}\"\n  }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('503 Service Unavailable', () => pm.response.to.have.status(503));",
                  "pm.test('error code is NO_SUBSCRIBERS', () => pm.expect(pm.response.json().error.code).to.eql('NO_SUBSCRIBERS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Credential Service got the event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/forward/credential-service/credentials/{{applicant_id}}",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "forward",
                "credential-service",
                "credentials",
                "{{applicant_id}}"
              ]
            },
            "description": "The event published above, delivered by the broker as POST /events/applicant_initialized: Credential Service forged the documents for that applicant."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Delivery happens in the background: give the broker a moment.",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('documents of the applicant from the event', () => pm.expect(body.applicant_id).to.eql(pm.collectionVariables.get('applicant_id')));",
                  "pm.test('the documents were forged', () => {",
                  "  pm.expect(body).to.have.property('student_id_doc');",
                  "  pm.expect(body).to.have.property('university_email');",
