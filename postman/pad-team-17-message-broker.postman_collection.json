            ],
            "url": {
              "raw": "{{broker_url}}/publish",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "publish"
              ]
            },
            "description": "topic, message_id and payload are all required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_id\": \"{{$guid}}\",\n  \"payload\": {\n    \"applicant_id\": \"{{applicant_id}}\",\n    \"deception\": \"false_year\",\n    \"name\": \"Postman Broker\",\n    \"student_id\": \"IA-24-0901\",\n    \"major\": \"FAF\",\n    \"year\": 3,\n    \"university_status\": \"faf_student\",\n    \"courses\": [\n      \"PAD\"\n    ],\n    \"role\": \"STUDENT\"\n  }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
