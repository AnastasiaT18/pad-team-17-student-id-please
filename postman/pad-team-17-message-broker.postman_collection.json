            },
            "description": "A message_id belongs to one event: reusing it for different content is refused.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"applicant_initialized\",\n  \"message_id\": \"{{message_id}}\",\n  \"payload\": {\n    \"applicant_id\": \"{{applicant_id}}\",\n    \"deception\": \"false_year\",\n    \"name\": \"Someone Else\",\n    \"student_id\": \"IA-24-0901\",\n    \"major\": \"FAF\",\n    \"year\": 3,\n    \"university_status\": \"faf_student\",\n    \"courses\": [\n      \"PAD\"\n    ],\n    \"role\": \"STUDENT\"\n  }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('error code is MESSAGE_ID_CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('MESSAGE_ID_CONFLICT'));"
                ]
