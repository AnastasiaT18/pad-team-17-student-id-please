    {
      "name": "Forwarding (Gateway to service)",
      "item": [
        {
          "name": "Forward to Applicant - the service answers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/forward/applicant-service/applicants/11111111-1111-4111-8111-111111111111",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "forward",
                "applicant-service",
                "applicants",
                "11111111-1111-4111-8111-111111111111"
              ]
