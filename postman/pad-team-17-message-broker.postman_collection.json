    {
      "name": "Topics and dead letters",
      "item": [
        {
          "name": "Topics - what the services subscribed to",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/topics",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "topics"
              ]
            },
            "description": "Grade 7: every topic some registered instance listed in its Service Discovery registration, sorted, each once."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const topics = pm.response.json().topics;",
                  "pm.test('Credential Service\\'s and Applicant Service\\'s topics are there', () => {",
                  "  pm.expect(topics).to.include.members(['applicant_initialized', 'credential_initialized', 'record_initialized']);",
                  "});",
                  "pm.test('each topic once, sorted', () => pm.expect(topics).to.eql([...new Set(topics)].sort()));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish an event its subscriber can never handle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{broker_url}}/publish",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "publish"
              ]
            },
            "description": "Grade 9: an applicant_initialized without applicant_id and deception. The broker accepts it - it does not read payloads - but Credential Service answers 422, so the broker does not try again and moves the delivery to its dead letters.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"applicant_initialized\",\n  \"message_id\": \"{{dead_message_id}}\",\n  \"payload\": {\n    \"name\": \"No Identity\"\n  }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('dead_message_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('Credential Service subscribed to the topic', () => pm.expect(pm.response.json().subscribers).to.include('credential-service'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dead letters - the event Credential Service refused",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/dead-letters",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "dead-letters"
              ]
            },
            "description": "Grade 9: poll for up to 20 seconds for this message and Credential Service together. Other subscribers may fail independently. Reading dead letters does not retry or remove them. The scenario requires Credential Service to reject this payload: HTTP 422 over REST, INVALID_ARGUMENT over gRPC."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const messageId = pm.collectionVariables.get('dead_message_id');",
                  "const subscriber = 'credential-service';",
                  "const deadline = Date.now() + 20000;",
                  "const url = pm.variables.replaceIn('{{broker_url}}/dead-letters');",
                  "",
                  "function inspect(response) {",
                  "  pm.test('200 OK while reading dead letters', () => pm.expect(response.code).to.eql(200));",
                  "  if (response.code !== 200) return;",
                  "  let letters;",
                  "  try {",
                  "    letters = response.json().dead_letters;",
                  "    if (!Array.isArray(letters)) throw new Error('dead_letters must be an array');",
                  "  } catch (error) {",
                  "    pm.test('valid dead-letter response', () => { throw error; });",
                  "    return;",
                  "  }",
                  "  const letter = letters.find((entry) => entry.message_id === messageId && entry.service === subscriber);",
                  "  if (!letter && Date.now() < deadline) {",
                  "    setTimeout(() => {",
                  "      if (Date.now() >= deadline) return finish(undefined);",
                  "      pm.sendRequest({ url, method: 'GET', timeout: Math.max(1, deadline - Date.now()) }, (error, next) => {",
                  "        if (error) {",
                  "          pm.test('dead-letter polling succeeds', () => pm.expect(error).to.eql(null));",
                  "          return;",
                  "        }",
                  "        inspect(next);",
                  "      });",
                  "    }, 500);",
                  "    return;",
                  "  }",
                  "  finish(letter);",
                  "}",
                  "",
                  "function finish(letter) {",
                  "  pm.test('Credential Service refused this event within 20 seconds', () => pm.expect(letter).to.be.an('object'));",
                  "  if (!letter) return;",
                  "  pm.test('the intended subscriber and topic are preserved', () => {",
                  "    pm.expect(letter.service).to.eql(subscriber);",
                  "    pm.expect(letter.topic).to.eql('applicant_initialized');",
                  "  });",
                  "  pm.test('refused at once: one attempt, 422 over REST or INVALID_ARGUMENT over gRPC', () => {",
                  "    pm.expect(letter.attempts).to.eql(1);",
                  "    pm.expect(letter.last_error).to.be.oneOf(['HTTP 422', 'gRPC INVALID_ARGUMENT']);",
                  "  });",
                  "  pm.test('the payload is kept as published', () => pm.expect(letter.payload).to.eql({ name: 'No Identity' }));",
                  "}",
                  "",
                  "pm.test('the scenario has a message ID', () => pm.expect(messageId).to.be.a('string').and.not.empty);",
                  "if (typeof messageId === 'string' && messageId.length > 0) inspect(pm.response);"
                ]
              }
            }
          ]
        }
      ]
    },
