                "channels",
                "{{channel_id}}"
              ]
            }
          }
        },
        {
          "name": "Get Session Channels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}/channels",
              "host": [
                "{{base_url}}"
              ],
