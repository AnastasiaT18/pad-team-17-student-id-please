  "item": [
    {
      "name": "Channels",
      "item": [
        {
          "name": "Create Channel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Channel created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  if (response.id) pm.collectionVariables.set('channel_id', response.id);",
                  "  pm.test('Created channel ID exists', () => pm.expect(response.id).to.be.a('string').and.not.empty);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"name\": \"general-mod-chat\",\n  \"player_ids\": [\n    \"{{player_id}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/channels",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "channels"
              ]
            },
            "description": "Requires a real session_id and player_id. A successful response stores channel_id. When testing in CPR, use a reachable service/Gateway HTTP route."
          }
        },
        {
          "name": "Get All Channels",
          "request": {
