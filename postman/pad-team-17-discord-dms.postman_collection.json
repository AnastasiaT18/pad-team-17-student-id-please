    {
      "name": "Lab 3 - Service Discovery & Replicas",
      "description": "Run after configuring discovery_url and deploying the service. These requests are read-only.",
      "item": [
        {
          "name": "1. Service HTTP Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health HTTP status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Service reports UP', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('object');",
                  "    pm.expect(body.status).to.eql('UP');",
                  "  });",
                  "}",
                  "pm.test('Discord health identity', () => pm.expect(pm.response.json().service).to.eql('discord-dms-service'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{discord_proxy_url}}/health",
            "description": "Discord health through its public proxy.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "2. Discovery HTTP Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Discovery health HTTP status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{discovery_url}}/health",
              "host": [
                "{{discovery_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks Discovery itself. Requires temporary localhost port mapping (see collection description).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "3. Verify Registered Replicas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Discovery responds with 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const instances = pm.response.json();",
                  "  const expected = Number(pm.collectionVariables.get('expected_replicas') || 2);",
                  "  pm.test('Response is an instance array', () => pm.expect(instances).to.be.an('array'));",
                  "  if (Array.isArray(instances)) {",
                  "    pm.test('Expected instance count', () => pm.expect(instances.length).to.eql(expected));",
                  "    pm.test('Instances have unique IDs and addresses', () => {",
                  "      pm.expect(new Set(instances.map(x => x.instance_id)).size).to.eql(instances.length);",
                  "      pm.expect(new Set(instances.map(x => x.host)).size).to.eql(instances.length);",
                  "    });",
                  "    pm.test('Every instance belongs to the service and is healthy', () => {",
                  "      instances.forEach(x => { pm.expect(x.service_name).to.eql('discord-dms-service'); pm.expect(x.healthy).to.eql(true); pm.expect(x.health.status).to.eql('UP'); });",
                  "    });",
                  "    pm.test('Instances advertise a gRPC port', () => instances.forEach(x => pm.expect(x.grpc_port).to.be.a('number')));",
                  "    if (instances[0]) { pm.collectionVariables.set('instance_1_id', instances[0].instance_id); pm.collectionVariables.set('instance_1_host', instances[0].host); }",
                  "    if (instances[1]) { pm.collectionVariables.set('instance_2_id', instances[1].instance_id); pm.collectionVariables.set('instance_2_host', instances[1].host); }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{discovery_url}}/services/discord-dms-service",
              "host": [
                "{{discovery_url}}"
              ],
              "path": [
                "services",
                "discord-dms-service"
              ]
            },
            "description": "Checks discord-dms-service appears with exactly expected_replicas distinct, healthy instances. Set expected_replicas=1 for a standalone test; in CPR Lab 3 it should be 2. Health may take several seconds to become UP after startup/restart.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "4. Capture IDs Before Discovery Restart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Discovery responds with 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const instances = pm.response.json();",
                  "  const expected = Number(pm.collectionVariables.get('expected_replicas') || 2);",
                  "  pm.test('Baseline has expected number of healthy replicas', () => {",
                  "    pm.expect(instances).to.be.an('array').with.lengthOf(expected);",
                  "    instances.forEach(x => pm.expect(x.healthy).to.eql(true));",
                  "  });",
                  "  if (Array.isArray(instances) && instances.length === expected && instances.every(x => x.healthy)) {",
                  "    pm.collectionVariables.set('baseline_instance_ids', JSON.stringify(instances.map(x => x.instance_id).sort()));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{discovery_url}}/services/discord-dms-service",
              "host": [
                "{{discovery_url}}"
              ],
              "path": [
                "services",
                "discord-dms-service"
              ]
            },
            "description": "Run once while two instances are healthy, BEFORE restarting Discovery. Saves sorted instance IDs to baseline_instance_ids for subsequent recovery check.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "5. Verify IDs After Discovery Restart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Discovery responds with 200', () => pm.response.to.have.status(200));",
                  "const baselineRaw = pm.collectionVariables.get('baseline_instance_ids');",
                  "pm.test('Baseline was captured first', () => pm.expect(baselineRaw, 'Run request 4 before restarting Discovery').to.be.a('string').and.not.empty);",
                  "if (pm.response.code === 200 && baselineRaw) {",
                  "  const instances = pm.response.json();",
                  "  const originalIds = JSON.parse(baselineRaw);",
                  "  const currentIds = instances.map(x => x.instance_id).sort();",
                  "  pm.test('Original instances re-register after Discovery restart', () => pm.expect(currentIds).to.deep.eql(originalIds));",
                  "  pm.test('Recovered instances are healthy', () => instances.forEach(x => { pm.expect(x.healthy).to.eql(true); pm.expect(x.health.status).to.eql('UP'); }));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{discovery_url}}/services/discord-dms-service",
              "host": [
                "{{discovery_url}}"
              ],
              "path": [
                "services",
                "discord-dms-service"
              ]
            },
            "description": "Restart ONLY Discovery outside Postman (docker compose restart discovery-service), allow at least one 15-second heartbeat plus health check, then send this request. Compares the current healthy instance IDs with the captured baseline; no container restart should be necessary.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
