        {
          "name": "Negotiate Discord DMs Socket.IO URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response has url', () => pm.expect(body).to.have.property('url'));",
                  "pm.collectionVariables.set('socket_url', body.url);",
                  "const socketioUrl = body.url.replace(/^http:/, 'ws:').replace(/^https:/, 'wss:');",
                  "pm.collectionVariables.set('socketio_url', socketioUrl);",
                  "pm.test('Negotiation points to Discord DMs, not Gateway', () => {",
                  "  pm.expect(body.url).to.not.include(':8090');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ws/discord-dms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ws",
                "discord-dms"
              ]
            },
            "description": "Authenticated negotiation through Gateway. Saves socket_url and socketio_url."
          },
          "response": []
        }
      ]
