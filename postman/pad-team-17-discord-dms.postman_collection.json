    {
      "name": "Messages",
      "item": [
        {
          "name": "Create Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Message created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  if (response.id) pm.collectionVariables.set('message_id', response.id);",
                  "  pm.test('Created message ID exists', () => pm.expect(response.id).to.be.a('string').and.not.empty);",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('message_id');"
                ]
              }
            }
          ],
          "request": {
