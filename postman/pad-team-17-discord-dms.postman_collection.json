        {
          "name": "05. Capture Discord DMs REST message baseline",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=sum%28discord_dms_http_requests_total%7Bjob%3D%22discord-dms-service%22%2Cmethod%3D%22POST%22%2Croute%3D%22%2Fchannels%2F%3Achannel_id%2Fmessages%22%2Cstatus%3D~%222..%22%7D%29%20or%20vector%280%29",
            "description": "Run before creating a new authorized message through REST POST /channels/{channel_id}/messages."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Prometheus REST message query succeeded', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.status).to.eql(\"success\");",
                  "  pm.expect(body.data.resultType).to.eql(\"vector\");",
                  "});",
                  "const rows = body.data && body.data.result ? body.data.result : [];",
                  "pm.test(\"A REST message POST counter is available\", () => {",
                  "  pm.expect(rows.length).to.eql(1);",
                  "  pm.expect(Number(rows[0].value[1])).to.be.at.least(0);",
                  "});",
                  "if (rows.length === 1 && Number.isFinite(Number(rows[0].value[1]))) {",
                  "  pm.collectionVariables.set(\"discord_dms_rest_message_baseline\", String(rows[0].value[1]));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06. Verify Discord DMs REST message activity increased",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=sum%28discord_dms_http_requests_total%7Bjob%3D%22discord-dms-service%22%2Cmethod%3D%22POST%22%2Croute%3D%22%2Fchannels%2F%3Achannel_id%2Fmessages%22%2Cstatus%3D~%222..%22%7D%29%20or%20vector%280%29",
            "description": "Run after request 05 and a successful REST POST /channels/{channel_id}/messages. Retries the Prometheus HTTP POST counter up to 15 times, 3 seconds apart. This verifies REST request activity, not Socket.IO broadcast or remote delivery."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baselineText = pm.collectionVariables.get(\"discord_dms_rest_message_baseline\");",
                  "const baselineValid = baselineText !== undefined && baselineText !== null && baselineText !== \"\" && Number.isFinite(Number(baselineText));",
                  "pm.test('Baseline was captured before the test action', () => pm.expect(baselineValid).to.eql(true));",
                  "function getCounter(response) {",
                  "  try {",
                  "    if (!response || response.code !== 200) return null;",
                  "    const body = response.json();",
                  "    if (body.status !== \"success\" || body.data.resultType !== \"vector\") return null;",
                  "    const rows = body.data.result;",
                  "    if (!Array.isArray(rows) || rows.length !== 1) return null;",
                  "    const value = Number(rows[0].value[1]);",
                  "    return Number.isFinite(value) ? value : null;",
                  "  } catch (_error) { return null; }",
                  "}",
                  "pm.test('Initial Prometheus query succeeded', () => pm.expect(getCounter(pm.response)).to.not.eql(null));",
                  "if (baselineValid) {",
                  "  const baseline = Number(baselineText);",
                  "  const queryUrl = pm.variables.replaceIn(pm.request.url.toString());",
                  "  const maxAttempts = 15;",
                  "  const retryDelayMs = 3000;",
                  "  let attempts = 1;",
                  "  let latest = getCounter(pm.response);",
                  "  function verifyOrRetry() {",
                  "    if (latest !== null && latest > baseline) {",
                  "      pm.test(\"Discord DMs REST message POST counter increased\", () => pm.expect(latest).to.be.above(baseline));",
                  "      console.log(\"Discord DMs REST message POST counter confirmed\", { baseline, latest, attempts });",
                  "      return;",
                  "    }",
                  "    if (attempts >= maxAttempts) {",
                  "      pm.test(\"Discord DMs REST message POST counter increased within retry window\", () => {",
                  "        pm.expect(latest, \"No counter increase after \" + attempts + \" Prometheus queries; check the service action and /metrics\").to.be.above(baseline);",
                  "      });",
                  "      return;",
                  "    }",
                  "    setTimeout(() => {",
                  "      pm.sendRequest({ url: queryUrl, method: \"GET\" }, (error, response) => {",
                  "        attempts += 1;",
                  "        if (!error) latest = getCounter(response);",
                  "        else console.warn(\"Prometheus retry failed:\", String(error));",
                  "        verifyOrRetry();",
                  "      });",
                  "    }, retryDelayMs);",
                  "  }",
                  "  verifyOrRetry();",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
