{
  "info": {
    "_postman_id": "8d1e7c28-9f24-4ac6-8d43-3ab1d2a80d01",
    "name": "Discord DMs \u2014 Lab 3",
    "description": "Use Gateway base_url=http://localhost:8090 and set token to a real login JWT, player_id to its player UUID, and session_id to a dedicated test session. Run Channels, Messages, then Cleanup in that order. The collection creates and deletes its own test channel/messages. Never substitute a real session-provisioned channel for channel_id. Requires the updated Discord release: REST provisioning returns 410; Session provisions memberships through internal gRPC. Discovery checks are optional and separate: discovery_url is intentionally empty because CPR does not publish Discovery. Supply an explicitly forwarded local address or an address reachable from a runner on the Docker network. Capture/recovery requests require a manual Discovery restart between them; a normal collection run does not prove restart recovery. Health uses the Discord proxy, not Gateway. HTTP checks do not prove Socket.IO authentication or cross-replica delivery. Do not commit tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8090",
      "description": "Authenticated Gateway URL"
    },
    {
      "key": "session_id",
      "value": "",
      "description": "Set to a REAL session UUID from Session service, not an illustrative UUID."
    },
