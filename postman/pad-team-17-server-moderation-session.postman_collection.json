		{
			"name": "End session",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Returns ended session and final results\", () => {",
							"  const body = pm.response.json();",
							"  pm.expect(body.session_id).to.eql(pm.collectionVariables.get(\"session_id\"));",
							"  pm.expect(body.status).to.eql(\"ended\");",
							"  pm.expect(body.final_score).to.be.a(\"number\");",
							"  pm.expect(body.results).to.be.an(\"array\").that.is.not.empty;",
							"  body.results.forEach(result => {",
							"    pm.expect(result.player_id).to.be.a(\"string\");",
							"    pm.expect(result.xp_gained).to.be.a(\"number\").and.at.least(0);",
							"    pm.expect(result.shift_completed).to.be.a(\"boolean\");",
							"    pm.expect(result.disciplinary_action).to.be.a(\"boolean\");",
							"  });",
							"});"
						]
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
