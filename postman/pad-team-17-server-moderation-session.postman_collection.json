		{
			"name": "Setup (Player Service, through the Gateway)",
			"item": [
				{
					"name": "Register moderator",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// new emails on every run, so the collection can be re-run without wiping the Player database",
									"const run = Date.now();",
									"pm.collectionVariables.set(\"run_id\", run);",
									"pm.collectionVariables.set(\"email\", `moderator${run}@example.com`);",
									"pm.collectionVariables.set(\"email_other\", `junior${run}@example.com`);",
									"pm.collectionVariables.unset(\"session_id\");",
									"pm.collectionVariables.unset(\"token\");",
									"pm.collectionVariables.unset(\"token_other\");"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/players",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"players"
