		{
			"name": "Lab 4 - internal operations through the broker",
			"description": "Operator requests, not public user routes. Requires the current Session image registered and healthy in Discovery, and the broker HTTP port published. The broker chooses one healthy replica. Logs contain that replica’s active file only; metrics counters are local to that replica, while outbox gauges describe the shared Session database. For consistent per-replica scraping use Prometheus directly in the Docker network.",
			"item": [
				{
					"name": "Download Session logs",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{broker_url}}/forward/server-moderation-session-service/logs",
							"host": [
								"{{broker_url}}"
							],
							"path": [
								"forward",
								"server-moderation-session-service",
								"logs"
							]
						},
						"description": "Use Postman’s response download/save option to save the attachment. Missing file: 404 LOG_NOT_FOUND; unreadable file: 503 LOG_UNAVAILABLE. Do not publish operational logs in Git."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Returns a text attachment\", () => {",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\");",
									"  pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\");",
									"  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
									"});",
									"pm.test(\"First entry is structured JSON when the file is non-empty\", () => {",
									"  const first = pm.response.text().trim().split(\"\\n\")[0];",
									"  if (first) {",
									"    const entry = JSON.parse(first);",
									"    pm.expect(entry.service).to.eql(\"server-moderation-session-service\");",
									"    pm.expect(entry.timestamp).to.be.a(\"string\");",
									"    pm.expect(entry.level).to.be.a(\"string\");",
									"  }",
									"});"
								]
							}
						}
					]
				},
