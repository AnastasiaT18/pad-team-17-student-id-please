  "item": [
    {
      "name": "Create session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response has session_id and status\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property(\"session_id\");",
              "  pm.expect(json.status).to.eql(\"created\");",
              "});",
              "pm.collectionVariables.set(\"session_id\", pm.response.json().session_id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{base_url}}/sessions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sessions"
          ]
        }
      },
      "response": []
