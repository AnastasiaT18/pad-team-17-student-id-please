  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Register moderator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/players",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"modermod{{run_id}}\", \"email\": \"moderation.moderator.{{run_id}}@example.com\", \"password\": \"PostmanLab5!2026\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0,12);",
                  "pm.collectionVariables.set('run_id',run);",
                  "pm.variables.set('run_id',run);",
                  "['token','token_junior','player_id','session_id','applicant_id','channel_id','message_id','decision_id','moderation_success_baseline','discord_dms_rest_message_baseline'].forEach(key => { pm.collectionVariables.unset(key); pm.variables.set(key,''); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let valid = pm.response.code === 201;",
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "try {",
                  " if (!valid) throw new Error('Setup request failed');",
                  " ",
                  "} catch (error) {",
                  " pm.test('Setup response is valid', () => { throw error; });",
                  " pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login moderator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/players/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"moderation.moderator.{{run_id}}@example.com\", \"password\": \"PostmanLab5!2026\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let valid = pm.response.code === 200;",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "try {",
                  " if (!valid) throw new Error('Setup request failed');",
                  " const body=pm.response.json(); pm.expect(body.token).to.be.a('string').and.not.empty; pm.collectionVariables.set('token',body.token); pm.variables.set('token',body.token); const claims=JSON.parse(atob(body.token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(claims.sub).to.be.a('string').and.not.empty; pm.collectionVariables.set('player_id',claims.sub); pm.variables.set('player_id',claims.sub);",
                  "} catch (error) {",
                  " pm.test('Setup response is valid', () => { throw error; });",
                  " pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
