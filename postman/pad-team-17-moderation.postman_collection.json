                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "try {",
                  " if (!valid) throw new Error('Setup request failed');",
                  " pm.expect(pm.response.json().status).to.eql('active');",
                  "} catch (error) {",
                  " pm.test('Setup response is valid', () => { throw error; });",
                  " pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for current applicant",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/sessions/{{session_id}}/current-applicant",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = 20;",
                  "let count = 1;",
                  "function inspect(response) {",
                  " let body; try { body = response.json(); } catch (_) {}",
                  " const ready = response && response.code === 200 && body && (typeof body.applicant_id === 'string' && body.applicant_id.length > 0);",
                  " if (ready) { pm.collectionVariables.set('applicant_id',body.applicant_id); pm.variables.set('applicant_id',body.applicant_id); pm.test('Required data became ready', () => pm.expect(ready).to.be.ok); return; }",
                  " if (count >= attempts || (response && [400,401,403].includes(response.code))) {",
                  "   pm.test('Required data became ready', () => pm.expect(Boolean(ready), 'Setup readiness failed; check upstream services').to.eql(true));",
                  "   pm.execution.setNextRequest(null); return;",
                  " }",
                  " count++;",
                  " setTimeout(() => pm.sendRequest({url:pm.variables.replaceIn(pm.request.url.toString()), method:'GET', header:{Authorization:'Bearer '+pm.variables.get('token')}}, (error, next) => inspect(error ? null : next)), 1000);",
                  "}",
                  "inspect(pm.response);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for credentials",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/credentials/{{applicant_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
