    {
      "name": "4. Socket.IO Preparation",
      "description": "Run after authentication and negotiation. For real cross-replica Redis testing, create two Postman Socket.IO requests pinned to different Traefik backends.",
      "item": [
        {
          "name": "Create two-player channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/channels",
            "description": "Creates a separate test channel for the two Socket.IO clients.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"name\": \"socketio-test\",\n  \"player_ids\": [\n    \"{{player_id}}\",\n    \"{{junior_player_id}}\"\n  ]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201){",
                  " const b=pm.response.json();",
                  " pm.test('Both players are members',()=>{",
                  "   pm.expect(b.player_ids).to.include(pm.collectionVariables.get('player_id'));",
                  "   pm.expect(b.player_ids).to.include(pm.collectionVariables.get('junior_player_id'));",
                  " });",
                  " pm.collectionVariables.set('socket_channel_id',b.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify two-player channel",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/channels/{{socket_channel_id}}",
            "description": "Confirm the channel exists."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200)pm.test('Correct ID',()=>pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('socket_channel_id')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lab 3 - Service Discovery & Replicas",
      "description": "Run after configuring discovery_url and deploying the service. These requests are read-only.",
      "item": [
        {
          "name": "1. Service HTTP Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health HTTP status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Service reports UP', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('object');",
                  "    pm.expect(body.status).to.eql('UP');",
                  "    pm.expect(body.service).to.eql('discord-dms-service');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
