    {
      "key": "discovery_url",
      "value": "",
      "type": "string",
      "description": "Host-local Discovery URL, forwarded from CPR container; not published by default."
    },
    {
      "key": "expected_replicas",
      "value": "2",
      "type": "string",
      "description": "Expected healthy replicas in CPR; set to 1 for a standalone service."
    },
    {
      "key": "baseline_instance_ids",
      "value": "",
