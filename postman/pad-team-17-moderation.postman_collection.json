{
  "info": {
    "name": "Moderation \u2014 Final decision regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against the updated Moderation release through Gateway. Set token to a real moderator login JWT, player_id to its UUID, session_id to an active session and applicant_id to its current applicant with initialized credentials/record. Choose verdict deliberately: this run submits one real, irreversible verdict and may change score/advance the applicant. Use a dedicated test session and fresh applicant each run. These checks do not prove Session role authorization or event consumption. A 201 means decision and event are stored, not that Session has updated its score. Do not put tokens in committed collections."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8090",
      "description": ""
    },
    {
      "key": "token",
      "value": "",
      "description": ""
    },
    {
      "key": "player_id",
      "value": "",
      "description": ""
    },
    {
      "key": "session_id",
      "value": "",
      "description": ""
    },
    {
      "key": "applicant_id",
      "value": "",
      "description": ""
    },
    {
      "key": "verdict",
      "value": "accept",
      "description": ""
    },
    {
      "key": "decision_id",
      "value": "",
      "description": ""
    },
    {
      "key": "prometheus_url",
      "value": "http://localhost:9091",
      "description": "CPR Prometheus endpoint (read-only query API)."
    },
    {
      "key": "expected_moderation_replicas",
      "value": "2",
      "description": "Expected deployed Moderation replicas in CPR."
    },
    {
      "key": "moderation_success_baseline",
      "value": "",
      "description": "Captured by the Lab 4 publication baseline request."
    }
  ],
  "item": [
    {
      "name": "Reject unauthenticated submission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"accept\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid verdict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"invalid\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit one final decision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"{{verdict}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const b = pm.response.json();",
              "  pm.collectionVariables.set('decision_id', b.id);",
              "  pm.test('Authenticated moderator persisted', () => pm.expect(b.moderator_id).to.eql(pm.variables.get('player_id')));",
              "  pm.test('Correct session and applicant', () => { pm.expect(b.session_id).to.eql(pm.variables.get('session_id')); pm.expect(b.applicant_id).to.eql(pm.variables.get('applicant_id')); });",
              "  pm.test('Requested verdict persisted', () => pm.expect(b.verdict).to.eql(pm.variables.get('verdict')));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Read saved decision",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/decisions/{{decision_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Saved decision returned', () => pm.expect(pm.response.json().id).to.eql(pm.variables.get('decision_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject duplicate decision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"{{verdict}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject revision of final decision",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/decisions/{{decision_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"reject\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject deletion of final decision",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/decisions/{{decision_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Lab 4 - Moderation observability and broker publication",
      "description": "Checks exclusively Moderation metrics collected by CPR Prometheus. No Session, DMs, Player, Applicant or Credential service requests are changed. Requires CPR Prometheus running at {{prometheus_url}}, with the Moderation scrape job installed and a published Moderation image that exposes /metrics. For event verification, first run request 04 to capture the success baseline; then run the existing \"Submit one final decision\" request with a fresh applicant and real moderator JWT (this is irreversible); wait at least two Prometheus scrape intervals (typically 15-20 seconds) and run request 05. This only confirms a broker publication was acknowledged, not delivery or consumption by another service. Do not use the collection runner to treat the requests as a single automated end-to-end test, because the baseline capture must occur before the original decision submission.",
      "item": [
        {
          "name": "01. Moderation replica scrape status",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=up%7Bjob%3D%22moderation-service%22%7D",
            "description": "The CPR deploys two Moderation replicas. Check targets are discovered and scrape is successful."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prometheus returned a successful query', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('success');",
                  "  pm.expect(pm.response.json().data.resultType).to.eql('vector');",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().status === 'success') {",
                  "  const result = pm.response.json().data.result;",
                  "  const expected = Number(pm.collectionVariables.get('expected_moderation_replicas') || 2);",
                  "  pm.test('Expected Moderation targets discovered', () => pm.expect(result.length).to.be.at.least(expected));",
                  "  pm.test('Every Moderation target is UP', () => {",
                  "    pm.expect(result.length).to.be.at.least(expected);",
                  "    result.forEach(row => pm.expect(Number(row.value[1])).to.eql(1));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Moderation PostgreSQL outbox query health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=moderation_outbox_query_success%7Bjob%3D%22moderation-service%22%7D",
            "description": "A gauge of 1 means the query for pending Moderation outbox rows succeeded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prometheus returned a successful query', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('success');",
                  "  pm.expect(pm.response.json().data.resultType).to.eql('vector');",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().status === 'success') {",
                  "  const result = pm.response.json().data.result;",
                  "  const expected = Number(pm.collectionVariables.get('expected_moderation_replicas') || 2);",
                  "  pm.test('Outbox query metric from Moderation replicas', () => pm.expect(result.length).to.be.at.least(expected));",
                  "  pm.test('All reported outbox database queries succeed', () => {",
                  "    pm.expect(result.length).to.be.at.least(expected);",
                  "    result.forEach(row => pm.expect(Number(row.value[1])).to.eql(1));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03. Inspect Moderation pending outbox events",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=moderation_outbox_pending%7Bjob%3D%22moderation-service%22%7D",
            "description": "Diagnostic only: pending events may temporarily exceed zero while delivery is in progress."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prometheus returned a successful query', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('success');",
                  "  pm.expect(pm.response.json().data.resultType).to.eql('vector');",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().status === 'success') {",
                  "  const result = pm.response.json().data.result;",
                  "  pm.test('Outbox backlog metric present', () => pm.expect(result.length).to.be.above(0));",
                  "  pm.test('Outbox backlog contains valid non-negative counts', () => {",
                  "    result.forEach(row => pm.expect(Number(row.value[1])).to.be.at.least(0));",
                  "  });",
                  "  console.log('Moderation pending outbox per replica:', result.map(row => ({instance: row.metric.instance, pending: Number(row.value[1])})));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04. Capture Moderation broker success baseline",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=sum%28moderation_event_publications_total%7Bjob%3D%22moderation-service%22%2Cresult%3D%22success%22%7D%29",
            "description": "Run BEFORE the existing irreversible \"Submit one final decision\" request. Saves the success counter baseline."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prometheus returned a successful query', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('success');",
                  "  pm.expect(pm.response.json().data.resultType).to.eql('vector');",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().status === 'success') {",
                  "  const result = pm.response.json().data.result;",
                  "  pm.test('Publication counter exists', () => pm.expect(result.length).to.eql(1));",
                  "  if (result.length === 1) {",
                  "    const value = Number(result[0].value[1]);",
                  "    pm.test('Publication counter is non-negative', () => pm.expect(value).to.be.at.least(0));",
                  "    pm.collectionVariables.set('moderation_success_baseline', String(value));",
                  "    console.log('Saved Moderation broker publication baseline:', value);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05. Verify Moderation broker success counter increased",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=sum%28moderation_event_publications_total%7Bjob%3D%22moderation-service%22%2Cresult%3D%22success%22%7D%29",
            "description": "Run AFTER a new decision was submitted and after at least two Prometheus scrapes (typically 15-20 seconds). An increasing success counter supports broker acknowledgement, not consumer delivery. It is a global counter, so other concurrent moderation events can also increase it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prometheus returned a successful query', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('success');",
                  "  pm.expect(pm.response.json().data.resultType).to.eql('vector');",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().status === 'success') {",
                  "  const result = pm.response.json().data.result;",
                  "  const baselineText = pm.collectionVariables.get('moderation_success_baseline');",
                  "  pm.test('Baseline was captured in request 04', () => pm.expect(baselineText).to.not.be.oneOf([undefined, null, '']));",
                  "  pm.test('Moderation broker publication advanced', () => {",
                  "    pm.expect(result.length).to.eql(1);",
                  "    pm.expect(baselineText).to.not.be.oneOf([undefined, null, '']);",
                  "    pm.expect(Number(result[0].value[1])).to.be.above(Number(baselineText));",
                  "  });",
                  "  console.log('Moderation broker success total:', result.length ? result[0].value[1] : 'missing');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
