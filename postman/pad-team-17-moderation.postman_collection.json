        {
          "name": "Provision Session Channels",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Four channels are provisioned', function () {",
                  "    const channels = pm.response.json();",
                  "",
                  "    pm.expect(channels).to.be.an('array');",
                  "    pm.expect(channels).to.have.length(4);",
                  "});",
                  "",
                  "pm.test('Expected channels are present', function () {",
                  "    const channels = pm.response.json();",
                  "    const names = channels.map((channel) => channel.name);",
                  "",
                  "    pm.expect(names).to.include.members([",
                  "        'enrollment-check',",
                  "        'course-registration',",
                  "        'schedule-check',",
                  "        'general-mod-chat'",
                  "    ]);",
                  "});",
                  "",
                  "pm.test('All provisioned channels belong to the session', function () {",
                  "    const channels = pm.response.json();",
                  "    const sessionId = pm.collectionVariables.get('session_id');",
                  "",
                  "    channels.forEach((channel) => {",
                  "        pm.expect(channel.session_id).to.eql(sessionId);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}/channels/provision",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "{{session_id}}",
                "channels",
                "provision"
              ]
            },
            "description": "Legacy request carried forward from the supplied collection. That collection described this as a Lab 1 mocked Session Service provisioning flow with four fixed channels. Verify the live service implementation before considering the 4-channel assertion an integration test of real Session Service functionality."
          }
