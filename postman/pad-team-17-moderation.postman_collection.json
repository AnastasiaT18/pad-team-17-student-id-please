{
  "info": {
    "name": "moderation-service \u2014 Automated Gateway regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the entire collection through Gateway with all game services healthy. Setup creates fresh moderator/junior accounts and an active test session on every iteration, obtains JWTs, and waits for required data. Tokens and IDs are generated at runtime; do not commit exported runtime values. Moderation submits a real final verdict; test accounts/session are intentionally retained for inspection. Set enable_monitoring=true to include Prometheus checks. The manual Discovery folder is skipped by default. To use it, set enable_manual_discovery=true and discovery_url, then send its requests individually, restarting Discovery between the capture and recovery requests. Set enable_manual_discovery=false before running the whole collection. This is HTTP regression coverage, not proof of 2PC, failover or Socket.IO behavior. Use Newman 6.2.1 or a current Postman runner; run with --bail for immediate assertion failures."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8090"
    },
    {
      "key": "token",
      "value": "",
      "description": "Generated during this collection run; leave empty in source control."
    },
    {
      "key": "player_id",
      "value": "",
      "description": "Generated during this collection run; leave empty in source control."
    },
    {
      "key": "session_id",
      "value": "",
      "description": "Generated during this collection run; leave empty in source control."
    },
    {
      "key": "applicant_id",
      "value": "",
      "description": "Generated during this collection run; leave empty in source control."
    },
    {
      "key": "verdict",
      "value": "accept",
      "description": ""
    },
    {
      "key": "decision_id",
      "value": "",
      "description": "Generated during this collection run; leave empty in source control."
    },
    {
      "key": "prometheus_url",
      "value": "http://localhost:9091",
      "description": "CPR Prometheus endpoint (read-only query API)."
    },
    {
      "key": "expected_moderation_replicas",
      "value": "2",
      "description": "Expected deployed Moderation replicas in CPR."
    },
    {
      "key": "moderation_success_baseline",
      "value": "",
      "description": "Generated during this collection run; leave empty in source control."
    },
