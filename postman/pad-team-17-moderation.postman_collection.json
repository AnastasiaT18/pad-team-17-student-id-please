{
  "info": {
    "name": "Moderation \u2014 Final decision regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against the updated Moderation release through Gateway. Set token to a real moderator login JWT, player_id to its UUID, session_id to an active session and applicant_id to its current applicant with initialized credentials/record. Choose verdict deliberately: this run submits one real, irreversible verdict and may change score/advance the applicant. Use a dedicated test session and fresh applicant each run. These checks do not prove Session role authorization or event consumption. A 201 means decision and event are stored, not that Session has updated its score. Do not put tokens in committed collections."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8090",
      "description": ""
    },
    {
      "key": "token",
      "value": "",
      "description": ""
    },
    {
      "key": "player_id",
      "value": "",
      "description": ""
    },
    {
      "key": "session_id",
      "value": "",
      "description": ""
    },
    {
      "key": "applicant_id",
      "value": "",
      "description": ""
    },
    {
      "key": "verdict",
      "value": "accept",
      "description": ""
    },
    {
      "key": "decision_id",
      "value": "",
      "description": ""
    }
  ],
  "item": [
    {
      "name": "Reject unauthenticated submission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"accept\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid verdict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"invalid\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit one final decision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"{{verdict}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const b = pm.response.json();",
              "  pm.collectionVariables.set('decision_id', b.id);",
              "  pm.test('Authenticated moderator persisted', () => pm.expect(b.moderator_id).to.eql(pm.variables.get('player_id')));",
              "  pm.test('Correct session and applicant', () => { pm.expect(b.session_id).to.eql(pm.variables.get('session_id')); pm.expect(b.applicant_id).to.eql(pm.variables.get('applicant_id')); });",
              "  pm.test('Requested verdict persisted', () => pm.expect(b.verdict).to.eql(pm.variables.get('verdict')));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Read saved decision",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/decisions/{{decision_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Saved decision returned', () => pm.expect(pm.response.json().id).to.eql(pm.variables.get('decision_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject duplicate decision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sessions/{{session_id}}/applicants/{{applicant_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"{{verdict}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject revision of final decision",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/decisions/{{decision_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verdict\": \"reject\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject deletion of final decision",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/decisions/{{decision_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    }
  ]
}
