                  "function inspect(response) {",
                  " let body; try { body = response.json(); } catch (_) {}",
                  " const ready = response && response.code === 200 && body && (typeof body === 'object');",
                  " if (ready) { ; pm.test('Required data became ready', () => pm.expect(ready).to.be.ok); return; }",
                  " if (count >= attempts || (response && [400,401,403].includes(response.code))) {",
                  "   pm.test('Required data became ready', () => pm.expect(Boolean(ready), 'Setup readiness failed; check upstream services').to.eql(true));",
