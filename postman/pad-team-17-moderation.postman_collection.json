      "name": "0. Setup - Two authenticated players and session",
      "description": "Run in order to generate real IDs and JWTs for tests. Requires CPR Gateway + Player + Session.",
      "item": [
        {
          "name": "Register moderator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/players",
            "description": "Create moderator player.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp=Date.now().toString()+Math.floor(Math.random()*100000).toString();",
                  "pm.collectionVariables.set('run_id',stamp);",
                  "pm.collectionVariables.set('username','mod'+stamp);",
                  "pm.collectionVariables.set('email','mod'+stamp+'@example.com');",
                  "pm.collectionVariables.set('junior_username','junior'+stamp);",
                  "pm.collectionVariables.set('junior_email','junior'+stamp+'@example.com');",
                  "['token','junior_token','session_id','channel_id','message_id','socket_channel_id'].forEach(k=>pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201)pm.collectionVariables.set('player_id',pm.response.json().player_id);"
                ]
              }
            }
