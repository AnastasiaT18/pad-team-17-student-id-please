                  "  });",
                  "  console.log('Moderation pending outbox per replica:', result.map(row => ({instance: row.metric.instance, pending: Number(row.value[1])})));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05. Verify Moderation broker success counter increased",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{prometheus_url}}/api/v1/query?query=sum%28moderation_event_publications_total%7Bjob%3D%22moderation-service%22%2Cresult%3D%22success%22%7D%29",
            "description": "Run after capturing request 04 baseline and submitting one NEW final decision. This check automatically re-queries Prometheus up to 15 times, 3 seconds apart (about 42 seconds of retries). The counter indicates broker acknowledgement, not consumer delivery; concurrent Moderation events can also increment it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baselineText = pm.collectionVariables.get(\"moderation_success_baseline\");",
                  "const baselineValid = baselineText !== undefined && baselineText !== null && baselineText !== \"\" && Number.isFinite(Number(baselineText));",
                  "pm.test('Baseline was captured before the test action', () => pm.expect(baselineValid).to.eql(true));",
                  "function getCounter(response) {",
                  "  try {",
                  "    if (!response || response.code !== 200) return null;",
                  "    const body = response.json();",
                  "    if (body.status !== \"success\" || body.data.resultType !== \"vector\") return null;",
                  "    const rows = body.data.result;",
                  "    if (!Array.isArray(rows) || rows.length !== 1) return null;",
                  "    const value = Number(rows[0].value[1]);",
                  "    return Number.isFinite(value) ? value : null;",
                  "  } catch (_error) { return null; }",
                  "}",
                  "pm.test('Initial Prometheus query succeeded', () => pm.expect(getCounter(pm.response)).to.not.eql(null));",
                  "if (baselineValid) {",
                  "  const baseline = Number(baselineText);",
                  "  const queryUrl = pm.variables.replaceIn(pm.request.url.toString());",
                  "  const maxAttempts = 15;",
                  "  const retryDelayMs = 3000;",
                  "  let attempts = 1;",
                  "  let latest = getCounter(pm.response);",
                  "  function verifyOrRetry() {",
                  "    if (latest !== null && latest > baseline) {",
                  "      pm.test(\"Moderation broker publication counter increased\", () => pm.expect(latest).to.be.above(baseline));",
                  "      console.log(\"Moderation broker publication counter confirmed\", { baseline, latest, attempts });",
                  "      return;",
                  "    }",
                  "    if (attempts >= maxAttempts) {",
                  "      pm.test(\"Moderation broker publication counter increased within retry window\", () => {",
                  "        pm.expect(latest, \"No counter increase after \" + attempts + \" Prometheus queries; check the service action and /metrics\").to.be.above(baseline);",
                  "      });",
                  "      return;",
                  "    }",
                  "    setTimeout(() => {",
                  "      pm.sendRequest({ url: queryUrl, method: \"GET\" }, (error, response) => {",
                  "        attempts += 1;",
                  "        if (!error) latest = getCounter(response);",
                  "        else console.warn(\"Prometheus retry failed:\", String(error));",
                  "        verifyOrRetry();",
                  "      });",
                  "    }, retryDelayMs);",
                  "  }",
                  "  verifyOrRetry();",
                  "}"
                ]
              }
            }
          ]
        }
