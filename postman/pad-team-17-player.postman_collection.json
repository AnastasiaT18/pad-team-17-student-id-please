        {
          "name": "Register player",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// new emails on every run, so the collection can be re-run without wiping the database",
                  "const run = Date.now();",
                  "pm.collectionVariables.set(\"run_id\", run);",
                  "pm.collectionVariables.set(\"email\", `testuser${run}@example.com`);",
                  "pm.collectionVariables.set(\"friend_email\", `testfriend${run}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response has a player_id\", () => pm.expect(pm.response.json()).to.have.property(\"player_id\"));",
                  "pm.collectionVariables.set(\"player_id\", pm.response.json().player_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"{{email}}\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "players"
              ]
            }
          },
          "response": []
        },
